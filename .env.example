# Optional. Every value below is also the built-in default, so a fresh clone runs
# without a .env file. Copy to .env only if you need to change something.

# Where the MLflow tracking server listens. Inside Docker Compose the API uses
# http://mlflow:5000 instead (set in docker-compose.yaml).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Experiment that holds every training and tuning run.
MLFLOW_EXPERIMENT=trip-duration

# Registered model name and the alias the API loads.
REGISTERED_MODEL_NAME=trip-duration
MODEL_ALIAS=production
